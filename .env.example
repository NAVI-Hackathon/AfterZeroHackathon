# 原團隊 Next / OpenAI / Turso 規格模板；目前 Mock Website 不需要這些值。
# NAVI 實際設定請使用 apps/api/.env.example 與 apps/web/.env.example。
# 複製成 .env.local 後填值（.env* 不進 git，只有本檔例外）
# 規格見 SPEC.md §12；驗證邏輯在 lib/env.ts

# OpenAI
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=
OPENAI_EMBEDDING_MODEL=

# Turso（libSQL）；本機可用 file:local.db，此時 TURSO_AUTH_TOKEN 可留空
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# 後台 /admin 密碼（至少 8 字元）
ADMIN_PASSWORD=

# 全站每日請求上限（正整數）
DAILY_REQUEST_LIMIT=
