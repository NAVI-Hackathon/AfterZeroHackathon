# Optional API base URL. Empty uses the Vite /api proxy (or same-origin deployment).
VITE_API_BASE_URL=
# Explicit demonstration backup only. Off by default, including production.
VITE_ENABLE_DEMO_FALLBACK=false
# Host websites allowed to embed NAVI in an iframe and exchange postMessage (comma-separated
# origins, exact match). Empty disables embedding. Local mock site: http://127.0.0.1:3000
VITE_EMBED_ALLOWED_ORIGINS=
# Mock insurer website used when NAVI runs standalone: NextAction links open it in a new tab.
# Local: http://127.0.0.1:3000
VITE_MOCK_SITE_URL=
